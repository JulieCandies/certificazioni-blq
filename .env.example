# Password per accedere come amministratore
ADMIN_PASSWORD=cambia-questa-password

# Chiave usata per firmare la sessione admin (una stringa lunga a caso)
SESSION_SECRET=cambia-anche-questa-stringa-lunga-a-caso

# Queste tre variabili vengono create automaticamente da Vercel
# quando colleghi un database "Vercel KV" al progetto. Non vanno
# scritte a mano: compaiono da sole dopo il collegamento.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=
